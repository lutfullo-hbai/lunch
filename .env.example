# Nusxa oling: cp .env.example .env  va qiymatlarni o'zgartiring.
# .env hech qachon commit qilinmaydi.

# --- Ilova ---
APP_NAME=Lunch API
ENVIRONMENT=development          # development | test | staging | production
LOG_LEVEL=INFO
TIMEZONE=Asia/Tashkent
CORS_ORIGINS=http://localhost:3000
# X-Forwarded-For faqat shu manzillardan (proxy, nginx) kelsa ishoniladi: rate limit
# userning haqiqiy IP'sini ko'radi. Docker ichida host'dagi nginx 172.16.0.0/12
# oralig'idagi bridge gateway'dan keladi. Hech qachon "*" qo'ymang: IP soxtalashtiriladi.
FORWARDED_ALLOW_IPS=172.16.0.0/12

# --- Auth ---
# Kamida 32 belgi. Yaratish: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# So'rov imzosi uchun alohida kalit, JWT_SECRET'dan farqli bo'lsin (yaratish usuli o'sha).
SIGNING_SECRET=change-me-to-another-long-random-secret-32-chars
# Rate limit, IP bo'yicha: oynada (soniya) ruxsat etilgan urinishlar.
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
REGISTER_RATE_LIMIT=5
REGISTER_RATE_WINDOW_SECONDS=3600
ORDER_RATE_LIMIT=20              # bitta user, oynada
ORDER_RATE_WINDOW_SECONDS=3600
ACCESS_TOKEN_TTL_MINUTES=1440    # 1 kun
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_REUSE_GRACE_SECONDS=30
TOKEN_RETENTION_DAYS=30
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
SIGNATURE_MAX_SKEW_SECONDS=60
NONCE_MAX_LENGTH=128

# --- Super admin (konteyner ishga tushganda yaratiladi) ---
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me-admin-password
SUPER_ADMIN_FULL_NAME=Super Admin

# --- Rasmlar ---
MAX_REQUEST_KB=64
MAX_UPLOAD_MB=6
MEDIA_DIR=media
MEDIA_URL_PREFIX=/media
IMAGE_MAX_UPLOAD_MB=5
IMAGE_MAX_PIXELS=16000000
IMAGE_MAX_PARALLEL=2
IMAGE_SIZE=1200
IMAGE_THUMB_SIZE=400
IMAGE_QUALITY=85

# --- Buyurtma ---
ORDER_MAX_LINES=50
CURRENCY=so'm

# --- Telegram: buyurtmalar guruhiga xabar ---
# Bot guruhga qo'shilgan va xabar yozish huquqiga ega bo'lishi kerak.
BOT_TOKEN=
# Guruh yoki kanal ID si: manfiy son, masalan -1001234567890
ORDERS_GROUP_CHAT_ID=
TELEGRAM_API_URL=https://api.telegram.org
TELEGRAM_TIMEOUT_SECONDS=10
NOTIFY_RETRY_DELAYS=[2, 4, 8]    # soniya

# --- Sahifalash ---
PAGE_SIZE_DEFAULT=20
PAGE_SIZE_MAX=100
PAGE_NUMBER_MAX=10000

# --- PostgreSQL (docker compose) ---
POSTGRES_DB=lunch
POSTGRES_USER=lunch
POSTGRES_PASSWORD=change-me
DB_HOST_PORT=5433
API_HOST_PORT=8080
# Frontend (nginx) manzili: http://localhost:8081
WEB_HOST_PORT=8081

# Docker'siz ishga tushirganda (uvicorn lokal). Docker ichida compose o'zi beradi.
DATABASE_URL=postgresql+asyncpg://lunch:change-me@localhost:5433/lunch
