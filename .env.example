# Nusxa oling: cp .env.example .env  va qiymatlarni o'zgartiring.
# .env hech qachon commit qilinmaydi.

# --- Ilova ---
APP_NAME=Lunch API
ENVIRONMENT=development          # development | test | staging | production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- Auth ---
# Kamida 32 belgi. Yaratish: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=1440    # 1 kun
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
SIGNATURE_MAX_SKEW_SECONDS=60

# --- Super admin (konteyner ishga tushganda yaratiladi) ---
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me-admin-password
SUPER_ADMIN_FULL_NAME=Super Admin

# --- PostgreSQL (docker compose) ---
POSTGRES_DB=lunch
POSTGRES_USER=lunch
POSTGRES_PASSWORD=change-me
DB_HOST_PORT=5433
API_HOST_PORT=8080

# Docker'siz ishga tushirganda (uvicorn lokal). Docker ichida compose o'zi beradi.
DATABASE_URL=postgresql+asyncpg://lunch:change-me@localhost:5433/lunch
